{{#features}}

    <li class="item" >
        <h5 class="rm-popup-title-feature">{{nom_court}}</h5>
        <span class="rm-popup-subtitle-feature dechetgestionnaire" gestionnaire='{{gestionnaire}}' > Cette déchèterie n'est pas gérée par Rennes Métropole. Son usage est réservé aux habitants et professionnels de la commune gestionnaire. Pour obtenir plus d'informations, veuillez prendre contact avec la commune sur laquelle elle se situe.</span>

        <p class="rm-popup-text-feature">
            {{#adresse}}<span class='rm-popup-label'> ADRESSE :</span> {{{adresse}}}<br/>{{/adresse}}<br/>
			
			 <span class='rm-popup-label'> HORAIRES :</span>
            <a href="https://dechets.metropole.rennes.fr/carte-et-horaires-des-decheteries/#horaires-des-decheteries-et-plateformes-vegetaux" target="_blank" rel="noopener noreferrer">
                Consulter les horaires
            </a>
            <br/>  
                  
            {{#commentaire}}<span class='rm-popup-label'> COMMENTAIRES :</span> {{{commentaire}}}<br/><br/>{{/commentaire}}

            <br/>

            <span class='rm-popup-label'> MATIÈRES ACCEPTÉES :</span><br/>
            <span class='liste_dechets'>
                <span class='rm_visible_{{{f_amiante}}}'> Amiante</span>
                <span class='rm_visible_{{{f_batteries}}}'> Batteries</span>
                <span class='rm_visible_{{{f_bois}}}'> Bois</span>
                <span class='rm_visible_{{{f_carton}}}'> Carton</span>
                <span class='rm_visible_{{{f_cart_impr}}}'> Cartouche d'imprimante</span>
                <span class='rm_visible_{{{f_dee}}}'> Électroménager (DEEE)</span>
                <span class='rm_visible_{{{f_ferraille}}}'> Ferraille</span>
                <span class='rm_visible_{{{f_gravats}}}'> Gravats</span>
                <span class='rm_visible_{{{f_huile_f}}}'> Huiles de friture</span>
                <span class='rm_visible_{{{f_huile_v}}}'> Huiles de vidange</span>
                <span class='rm_visible_{{{f_incinerables}}}'> Incinérables</span>
                <span class='rm_visible_{{{f_jm}}}'> Journaux et magazines</span>
                <span class='rm_visible_{{{f_mobilier}}}'> Mobilier</span>
                <span class='rm_visible_{{{f_piles}}}'> Piles</span>
                <span class='rm_visible_{{{f_plastrigides}}}'> Plastiques rigides</span>
                <span class='rm_visible_{{{f_platre}}}'> Plâtres</span>
                <span class='rm_visible_{{{f_pneus}}}'> Pneus</span>
                <span class='rm_visible_{{{f_toxique}}}'> Produits toxiques</span>
                <span class='rm_visible_{{{reemploi}}}'> Réemploi (objets réutilisables)</span>
                <span class='rm_visible_{{{f_souches}}}'> Souches</span>
                <span class='rm_visible_{{{f_textile}}}'> Textiles</span>
                <span class='rm_visible_{{{f_tt_vt}}}'> Tout-venant</span>
                <span class='rm_visible_{{{dv_caisson}}}'> Végétaux en caisson (hors tonte)</span>
                <span class='rm_visible_{{{dv_pf}}}'> Végétaux sur plateforme (hors tonte)</span>
                <span class='rm_visible_{{{f_verre}}}'> Verre</span>
            </span>
        </p>
    </li>
{{/features}}



