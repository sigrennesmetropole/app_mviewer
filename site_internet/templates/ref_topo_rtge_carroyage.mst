<hash style="display:none;">1061485373</hash>{{#features}}
      <li id="{{feature_ol_uid}}" class="item mstudio_template" style="width:100%;">
        
    
    <div class="imageComponent template-component mb-2"
      data-value="https://public.sig.rennesmetropole.fr/ressources/catalogue/apercus/ref_topo_toposurf_rctr_carroyage.png"
      data-type-selector="static"
      data-component="imageComponent"
    >
    <img src="https://public.sig.rennesmetropole.fr/ressources/catalogue/apercus/ref_topo_toposurf_rctr_carroyage.png" class="img img-responsive" style="max-height:300px;"/>
    </div>
    
    
    <div class="textH1Component template-component mb-2" id="995d80eb-f541-4e17-831c-f6d2308b5560"
      data-type-selector="static"
      data-color="#000000"
      data-value="Casé sélectionné :"
      data-component="textH1Component"
    >
        <!--
        Variable : nom
        Prop : color
        -->
        <h3 style="font-weight:bold; color:#000000;">Casé sélectionné :</h3>
    </div>
    {{#cases_200}}
    <div class="textTextComponent template-component mb-2"
      data-type-selector="field"
      data-value="cases_200"
      data-component="textTextComponent"
    >
        <p>{{#cases_200}}{{cases_200}}{{/cases_200}}</p>
    </div>
    {{/cases_200}}
    {{#url_dxf_surface}}
    <div class="linkComponent template-component mb-2"
      data-type-selector="field"
      data-value="url_dxf_surface"
      data-text="Télécharger le casé"
      data-icon="fas fa-download "
      data-color="#ffffff"
      data-bg-color="#000000"
      data-component="linkComponent"
    >
      <a href="{{#url_dxf_surface}}{{url_dxf_surface}}{{/url_dxf_surface}}" target="_blank" class="btn" style="background-color: #000000;color:#ffffff;">
        <i class="fas fa-download "></i>
        Télécharger le casé
      </a>
    </div>
    {{/url_dxf_surface}}
    
      </li>
    {{/features}}